# Server configuration
PORT=3000
NODE_ENV=development
# Crawler mutation endpoints are always available in development. In production,
# explicitly set this to true before run/start/stop requests are accepted.
ENABLE_CRAWLER_API=false

# Google Maps Platform Credentials
# IMPORTANT: Never commit actual API keys to repository. Set this in your local .env file.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AMap (高德地图) Web Service Credentials
AMAP_API_KEY=your_amap_api_key_here

# Optional Overpass endpoint for estimated traffic-signal counts on bicycling routes.
# If unreachable, fewest-signals routing falls back to the shortest AMap candidate.
OSM_TRAFFIC_SIGNAL_OVERPASS_URL=https://overpass-api.de/api/interpreter

# AMap HotPoint offline crawler controls
ENABLE_HOT_POINT_CRAWLER=false
# Optional comma-separated filters, e.g. AMAP_HOT_POINT_DISTRICTS=黄浦区,徐汇区
AMAP_HOT_POINT_DISTRICTS=
# Optional categories: scenic,supply,rest,service,start_end
AMAP_HOT_POINT_CATEGORIES=
AMAP_HOT_POINT_MAX_PAGES=3
AMAP_HOT_POINT_PAGE_SIZE=25
AMAP_HOT_POINT_REQUEST_DELAY_MS=500
AMAP_HOT_POINT_CRAWLER_INTERVAL_HOURS=24
HOT_POINT_SEGMENT_LINK_RADIUS_M=1500
HOT_POINT_SEGMENT_LINK_LIMIT=3
HOT_POINT_SKIP_SCHEMA_INIT=true
HOT_POINT_DRY_RUN=false

# MySQL Database Configuration
DATABASE_URL=mysql://root:root@127.0.0.1:3306/veloroam

# Strava Developer API Credentials
# Replace these with your actual Strava app credentials
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_REFRESH_TOKEN=your_strava_refresh_token_here

# Direct Strava Access Token (Optional fallback)
# Set this to use a valid access token directly, bypassing the refresh token flow in development/testing
STRAVA_ACCESS_TOKEN=your_valid_access_token_here

# Native Strava popularity enrichment (star_count, athlete_count, effort_count)
# Live cache misses enrich only the top N segments to protect the read quota.
STRAVA_NATIVE_STATS_ENRICH_LIMIT=3
# The continuous crawler does not issue detail calls unless explicitly enabled.
STRAVA_CRAWLER_NATIVE_STATS_LIMIT=0
# Manual backfill defaults: 25 detail requests with a 1 second interval.
STRAVA_NATIVE_STATS_BACKFILL_LIMIT=25
STRAVA_NATIVE_STATS_BACKFILL_OFFSET=0
STRAVA_NATIVE_STATS_BACKFILL_DELAY_MS=1000

# API Rate Limits and Quotas (Security controls)
# Maximum elevation sampling points per routing request (budget protector)
MAX_ELEVATION_SAMPLES=100

# DeepSeek recommendation (server only)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
