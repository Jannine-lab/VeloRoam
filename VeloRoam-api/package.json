{
  "name": "veloroam-api",
  "version": "1.0.0",
  "description": "Backend API service for VeloRoam cycling route planner",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --require ts-node/register/transpile-only src/index.ts",
    "crawl:hotpoints": "ts-node src/scripts/amapHotPointCrawler.ts",
    "audit:shanghai-signals": "ts-node src/scripts/auditShanghaiSignals.ts",
    "backfill:strava-stats": "ts-node src/scripts/stravaNativeStatsBackfill.ts",
    "backfill:strava-details": "ts-node src/scripts/stravaSegmentDetailsBackfill.ts",
    "init:recommendation-tables": "ts-node src/scripts/initRecommendationTables.ts",
    "lint": "eslint 'src/**/*.ts'",
    "test": "node --test --test-concurrency=4 --require ts-node/register/transpile-only src/controllers/*.test.ts src/services/*.test.ts src/evals/*.test.ts",
    "cache:strava-details": "ts-node src/scripts/cacheStravaSegmentDetails.ts",
    "eval:idea": "ts-node src/evals/ideaConversationEval.ts",
    "backfill:segment-tags": "ts-node src/scripts/backfillSegmentTags.ts",
    "test:ui": "node --test ../VeloRoam-ui/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cycling",
    "routing",
    "google-maps",
    "elevation",
    "gpx"
  ],
  "author": "VeloRoam Team",
  "license": "ISC",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@langchain/core": "^1.3.1",
    "@langchain/deepseek": "^1.1.21",
    "@langchain/langgraph": "^1.7.2",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.22.4",
    "pg": "^8.11.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
